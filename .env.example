# Copy to .env locally. Never commit real credentials.
APP_ENV=development
APP_NAME=Automation Hub
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# OpenAI is optional until AI features are enabled.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Future integrations: add credentials locally only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
DATABASE_URL=sqlite:///./automation_hub.db
