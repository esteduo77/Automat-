# Copy to .env locally. Never commit real credentials.
APP_ENV=development
APP_NAME=Automation Hub
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# OAuth credentials: configure exact callback URLs in provider consoles.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_ENCRYPTION_KEY=
OAUTH_REDIRECT_BASE=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
DATABASE_URL=sqlite:///./automation_hub.db

# Worker: keep one API process while using the built-in SQLite queue worker.
WORKER_POLL_SECONDS=2

# Generate a unique random secret (32+ characters); never use the example value.
JWT_SECRET=CHANGE-ME-USE-A-LONG-RANDOM-SECRET
ACCESS_TOKEN_MINUTES=720
